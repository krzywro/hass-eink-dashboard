{%- from "_macros.svg.j2" import card_container -%}
<svg xmlns="http://www.w3.org/2000/svg"
     width="{{ w }}" height="{{ h }}">
{%- if has_entity -%}
{%- call card_container(
    x=0, y=0, w=w, h=h,
    card_style=card_style,
    radius=m_radius, border=m_border,
    bar_width=bar_width,
    border_color=hex_black,
    bar_color=hex_gray) -%}
{#- Cloud tint is below every grid separator. Four-level displays use
    a sparse native-gray pattern, keeping the light band visible even
    when the output palette is applied without error diffusion. -#}
{%- if show_cloud_band -%}
{%- if cloud_pattern -%}
<defs>
{#- One native-gray pixel per four pixels averages about 234 on white,
    close to the 30% cloud tint, without inventing a fifth gray level. -#}
<pattern id="mgCloudTint" patternUnits="userSpaceOnUse" width="2" height="2">
<rect width="1" height="1" fill="{{ hex_hour_grid }}"/>
</pattern>
</defs>
{%- endif -%}
<path d="{{ cloud_band_path }}"
  fill="{{ cloud_fill }}" fill-opacity="{{ cloud_opacity }}" stroke="none"/>
{%- endif -%}
{#- Full local-hour boundaries; independent of annotation thinning. -#}
{%- for line in hour_grid_lines -%}
<line x1="{{ line.x }}" y1="{{ line.y1 }}"
      x2="{{ line.x }}" y2="{{ line.y2 }}"
      stroke="{{ hex_hour_grid }}" stroke-width="1"
      stroke-dasharray="4,3"/>
{%- endfor -%}
{#- Day-boundary markers: dashed line (all but the first) plus a
    weekday/date label. -#}
{%- for marker in day_markers -%}
{%- if marker.show_line -%}
<line x1="{{ marker.x }}" y1="{{ marker.line_y1 }}"
      x2="{{ marker.x }}" y2="{{ marker.line_y2 }}"
      stroke="{{ hex_gray }}" stroke-width="1"
      stroke-dasharray="4,3"/>
{%- endif -%}
<text x="{{ marker.x }}" y="{{ day_label_y }}"
  font-family="Roboto"
  font-size="{{ day_label_font_sz }}"
  dominant-baseline="hanging"
  fill="{{ hex_black }}">{{ marker.label }}</text>
{%- endfor -%}
{#- Y-axis gridlines and labels. -#}
{%- for grid in grid_lines -%}
<line x1="{{ content_left }}" y1="{{ grid.y }}"
      x2="{{ content_right }}" y2="{{ grid.y }}"
      stroke="{{ hex_light_gray }}"
      stroke-width="{{ grid_stroke_w }}"/>
{%- if show_y_axis_labels -%}
<text x="{{ content_left }}" y="{{ grid.label_y }}"
  font-family="Roboto"
  font-size="{{ grid_font_sz }}"
  dominant-baseline="auto"
  fill="{{ hex_text_gray }}">{{ grid.label }}</text>
{%- endif -%}
{%- endfor -%}
{#- Precipitation bars: grow upward from the plot baseline, with
    optional centered amount labels inside their bottom edge. Labels
    that cannot fit are omitted. Drawing after the grid keeps their
    digits clear of the grid strokes. -#}
{%- if show_precip -%}
{%- for bar in precip_bars -%}
<rect x="{{ bar.x }}" y="{{ bar.y }}"
  width="{{ bar.w }}" height="{{ bar.h }}"
  fill="{{ hex_gray }}" fill-opacity="0.5"/>
{%- if bar.label -%}
<text x="{{ bar.label_x }}" y="{{ bar.label_y }}"
  font-family="Roboto"
  font-size="{{ precip_font_sz }}"
  font-weight="bold"
  text-anchor="middle"
  dominant-baseline="auto"
  fill="{{ hex_black }}">{{ bar.label }}</text>
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{#- Solid black temperature curve for maximum e-ink contrast. -#}
{%- if curve_path -%}
<path d="{{ curve_path }}"
  fill="none"
  stroke="{{ hex_black }}"
  stroke-width="{{ curve_stroke_w }}"
  stroke-linejoin="round"
  stroke-linecap="round"/>
{%- endif -%}
{#- Condition icons, floating just above the curve. -#}
{%- for icon in icons -%}
<g transform="translate({{ icon.x }}, {{ icon.y }})">{{ icon.svg }}</g>
{%- endfor -%}
{#- Temperature labels follow the curve from below. A narrow white
    halo keeps digits readable over the precipitation bars/grid. -#}
{%- for label in temperature_labels -%}
<text x="{{ label.x }}" y="{{ label.y }}"
  font-family="Roboto" font-size="{{ detail_font_sz }}" font-weight="500"
  text-anchor="{{ label.anchor }}" dominant-baseline="hanging"
  stroke="{{ hex_white }}" stroke-width="{{ label_halo_w }}"
  stroke-linejoin="round" paint-order="stroke fill"
  fill="{{ hex_black }}">{{ label.temperature_label }}</text>
{%- endfor -%}
{#- Hour-axis ticks below the plot. -#}
{%- for tick in hour_ticks -%}
<text x="{{ tick.x }}" y="{{ hour_row_y }}"
  font-family="Roboto"
  font-size="{{ hour_font_sz }}"
  text-anchor="{{ tick.anchor }}"
  dominant-baseline="hanging"
  fill="{{ hex_text_gray }}">{{ tick.label }}</text>
{%- endfor -%}
{#- Forecast wind below the hours: arrowhead points downwind, with
    speed and the entity's unit underneath. Calm has no arrow. -#}
{%- for wind in wind_columns -%}
{%- if wind.angle is not none -%}
<g transform="translate({{ wind.arrow_x }}, {{ wind_arrow_y }})
  rotate({{ wind.angle }}) scale({{ wind_arrow_scale }})">
<path d="M0,-10 L6,0 L2,0 L2,10 L-2,10 L-2,0 L-6,0 Z"
  fill="{{ hex_black }}"/>
</g>
{%- elif not wind.calm -%}
<text x="{{ wind.arrow_x }}" y="{{ wind_arrow_y }}"
  font-family="Roboto" font-size="{{ detail_font_sz }}"
  text-anchor="middle" dominant-baseline="central"
  fill="{{ hex_text_gray }}">—</text>
{%- endif -%}
<text x="{{ wind.x }}" y="{{ wind_speed_y }}"
  font-family="Roboto" font-size="{{ detail_font_sz }}"
  text-anchor="{{ wind.anchor }}" dominant-baseline="hanging"
  fill="{{ hex_black }}">{{ wind.speed_label }}</text>
{%- endfor -%}
{%- endcall -%}
{#- No entity or no usable hourly forecast: render blank SVG. -#}
{%- endif -%}
</svg>
